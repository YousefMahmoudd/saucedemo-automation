<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemoSuite" parallel="tests" thread-count="4" verbose="1">

    <listeners>
        <listener class-name="com.saucedemo.listeners.TestListener"/>
    </listeners>

    <test name="LoginTests">
        <classes>
            <class name="com.saucedemo.tests.LoginTest"/>
        </classes>
    </test>

    <test name="InventoryTests">
        <classes>
            <class name="com.saucedemo.tests.InventoryTest"/>
        </classes>
    </test>

    <test name="CartTests">
        <classes>
            <class name="com.saucedemo.tests.CartTest"/>
        </classes>
    </test>

    <test name="CheckoutTests">
        <classes>
            <class name="com.saucedemo.tests.CheckoutTest"/>
        </classes>
    </test>

    <test name="LogoutTests">
        <classes>
            <class name="com.saucedemo.tests.LogoutTest"/>
        </classes>
    </test>

    <test name="CartSessionTests">
        <classes>
            <class name="com.saucedemo.tests.CartSessionTest"/>
        </classes>
    </test>

</suite>
